#!/bin/sh
# Blocks commits that contain NVIDIA HairWorks SDK material (GameWorks EULA section 8). See tools/sdk_guard.py.
# Enabled per clone with: git config core.hooksPath .githooks
PY=py
command -v py >/dev/null 2>&1 || PY=python3
exec "$PY" "$(git rev-parse --show-toplevel)/tools/sdk_guard.py" --staged
